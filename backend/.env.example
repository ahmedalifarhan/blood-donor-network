# Blood Donor Network API — copy to .env and fill in. Never commit .env (constitution VII).

APP_NAME=BloodDonorNetwork
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
# Build commit SHA, shown only in the operator health view.
APP_VERSION=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=info

# No database is used. Cache holds read caches and locks (file store: single instance).
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Storage driver: memory (local dev, tests) | sheets (deployed)
DATA_DRIVER=memory

# Google Sheets (required when DATA_DRIVER=sheets).
# Spreadsheet title must end with "[sandbox]" or "[production]".
GOOGLE_SHEET_ID=
# Service-account key: raw JSON or base64-encoded JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Long random strings (e.g. `php -r "echo bin2hex(random_bytes(32));"`).
SCHEDULER_SECRET=
OPERATOR_HEALTH_SECRET=

# The only origin allowed to call the API from a browser (CORS).
FRONTEND_URL=http://localhost:3000
