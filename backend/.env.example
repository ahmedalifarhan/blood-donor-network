# Blood Donor Network API — copy to .env and fill in. Never commit .env (constitution VII).

APP_NAME=BloodDonorNetwork
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
# Build commit SHA, shown only in the operator health view.
APP_VERSION=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Cache holds the health probe result and rate-limit counters (file store: single instance).
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Database. Local development: SQLite in database/database.sqlite (git-ignored);
# create it with `php artisan migrate`. Deployed: PostgreSQL.
DB_CONNECTION=sqlite
# PostgreSQL only (DB_CONNECTION=pgsql): one connection URL from the database host,
# e.g. postgresql://user:password@host:5432/dbname?sslmode=require
DB_URL=

# Long random strings (e.g. `php -r "echo bin2hex(random_bytes(32));"`).
SCHEDULER_SECRET=
OPERATOR_HEALTH_SECRET=

# The only origin allowed to call the API from a browser (CORS).
FRONTEND_URL=http://localhost:3000
