# Never ship secrets or local state into the image.
.env
.env.*
!.env.example

# Rebuilt inside the image / not needed at runtime.
vendor/
node_modules/
tests/
.phpunit.cache/
.phpunit.result.cache
phpunit.xml
phpstan.neon
pint.json

# Local databases (SQLite dev and e2e files).
database/*.sqlite*

storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

*.log
.git
.gitignore
.gitattributes
.editorconfig
Dockerfile
.dockerignore
